<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fond_clavier">

    <!-- Zone du haut (environ 45% de l'écran sur fond turquoise) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/zoneHaut"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/turquoise_fond"
        android:padding="20dp"
        app:layout_constraintBottom_toTopOf="@+id/clavierNumerique"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_weight="45">

        <!-- Titre Currency Converter -->
        <TextView
            android:id="@+id/tvTitre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/titre_app"
            android:textColor="@color/blanc"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Ligne 1 : Devise Source + Montant Saisi -->
        <Spinner
            android:id="@+id/spDeviseSource"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:backgroundTint="@color/texte_sombre"
            app:layout_constraintBottom_toTopOf="@+id/btnInverser"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTitre" />

        <TextView
            android:id="@+id/tvMontant"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:gravity="end"
            android:text="@string/valeur_initiale_montant"
            android:textColor="@color/texte_sombre"
            android:textSize="48sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/spDeviseSource"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/spDeviseSource"
            app:layout_constraintTop_toTopOf="@+id/spDeviseSource" />

        <View
            android:id="@+id/ligneMontant"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:background="@color/texte_sombre"
            app:layout_constraintEnd_toEndOf="@+id/tvMontant"
            app:layout_constraintStart_toStartOf="@+id/tvMontant"
            app:layout_constraintTop_toBottomOf="@+id/tvMontant" />

        <!-- Bouton Inverser -->
        <ImageButton
            android:id="@+id/btnInverser"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/desc_inverser"
            android:src="@drawable/ic_swap"
            app:layout_constraintBottom_toTopOf="@+id/spDeviseCible"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/spDeviseSource" />

        <!-- Ligne 2 : Devise Cible + Résultat -->
        <Spinner
            android:id="@+id/spDeviseCible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:backgroundTint="@color/texte_sombre"
            app:layout_constraintBottom_toTopOf="@+id/btnConvertir"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnInverser" />

        <TextView
            android:id="@+id/tvResultat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:gravity="end"
            android:textColor="@color/texte_sombre"
            android:textSize="48sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/spDeviseCible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/spDeviseCible"
            app:layout_constraintTop_toTopOf="@+id/spDeviseCible" />

        <View
            android:id="@+id/ligneResultat"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:background="@color/texte_sombre"
            app:layout_constraintEnd_toEndOf="@+id/tvResultat"
            app:layout_constraintStart_toStartOf="@+id/tvResultat"
            app:layout_constraintTop_toBottomOf="@+id/tvResultat" />

        <!-- Bouton CONVERTIR -->
        <Button
            android:id="@+id/btnConvertir"
            android:layout_width="160dp"
            android:layout_height="48dp"
            android:backgroundTint="@color/bouton_convertir"
            android:text="@string/btn_convertir"
            android:textColor="@color/bouton_convertir_texte"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Zone du bas : Clavier numérique personnalisé (TableLayout 4 x 3) -->
    <TableLayout
        android:id="@+id/clavierNumerique"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/fond_clavier"
        android:padding="8dp"
        android:stretchColumns="*"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/zoneHaut"
        app:layout_constraintVertical_weight="55">

        <!-- Ligne 1 : 7, 8, 9 -->
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <Button
                android:id="@+id/btn7"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="7"
                android:textColor="@color/turquoise_clavier"
                android:textSize="32sp" />

            <Button
                android:id="@+id/btn8"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="8"
                android:textColor="@color/turquoise_clavier"
                android:textSize="32sp" />

            <Button
                android:id="@+id/btn9"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="9"
                android:textColor="@color/turquoise_clavier"
                android:textSize="32sp" />
        </TableRow>

        <!-- Ligne 2 : 4, 5, 6 -->
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <Button
                android:id="@+id/btn4"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="4"
                android:textColor="@color/turquoise_clavier"
                android:textSize="32sp" />

            <Button
                android:id="@+id/btn5"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="5"
                android:textColor="@color/turquoise_clavier"
                android:textSize="32sp" />

            <Button
                android:id="@+id/btn6"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="6"
                android:textColor="@color/turquoise_clavier"
                android:textSize="32sp" />
        </TableRow>

        <!-- Ligne 3 : 1, 2, 3 -->
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <Button
                android:id="@+id/btn1"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="1"
                android:textColor="@color/turquoise_clavier"
                android:textSize="32sp" />

            <Button
                android:id="@+id/btn2"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="2"
                android:textColor="@color/turquoise_clavier"
                android:textSize="32sp" />

            <Button
                android:id="@+id/btn3"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="3"
                android:textColor="@color/turquoise_clavier"
                android:textSize="32sp" />
        </TableRow>

        <!-- Ligne 4 : C, 0, . -->
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <Button
                android:id="@+id/btnC"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/touche_c"
                android:textColor="@color/rouge_clavier"
                android:textSize="32sp" />

            <Button
                android:id="@+id/btn0"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="0"
                android:textColor="@color/turquoise_clavier"
                android:textSize="32sp" />

            <Button
                android:id="@+id/btnPoint"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/touche_point"
                android:textColor="@color/turquoise_clavier"
                android:textSize="32sp" />
        </TableRow>
    </TableLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
